# Docker Environment Configuration
# This file contains all environment variables for the containerized deployment

# Frontend (Vite React App)
VITE_API_URL=http://localhost:3000
FRONTEND_PORT=5173

# Backend (Node.js Express Server)
NODE_ENV=development
PORT=3000

# Port Configuration
BACKEND_EXPOSED_PORT=3000
FRONTEND_EXPOSED_PORT=5173
DB_EXPOSED_PORT=5432

# Database Configuration
# Backend connection variables (used by Node.js app)
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=database
DB_PORT=5432
DB_NAME=mydb
DB_SSL=false

# PostgreSQL Container Environment Variables
# These specific variable names (POSTGRES_*) are required by the official PostgreSQL Docker image
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# JWT Secret: at least 32 characters, otherwise login and registration answer 503.
# Production (Azure App Settings) needs its own random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=docker_jwt_secret_key_change_in_production

# TMDB "API Read Access Token" (https://www.themoviedb.org/settings/api).
# Used only by the manual import command: npm --prefix api run tmdb:sync-movie-details
# The web application does not need it. Never put it in a VITE_* variable.
TMDB_READ_TOKEN=
